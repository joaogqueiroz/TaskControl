@using System.Globalization
@{
    ViewData["Title"] = "Your account";
    ViewData["Narrow"] = true;
    Layout = "~/Views/Shared/Layout.cshtml";
    var us = CultureInfo.GetCultureInfo("en-US");
    var since = TempData["RegistrationDate"]?.ToString();
    if (DateTime.TryParseExact(since, "MM/dd/yyyy", us, DateTimeStyles.None, out var registered))
    {
        since = registered.ToString("MMM d, yyyy", us);
    }
}

<h1>Your account</h1>
<div class="sheet facts">
    <div class="fact"><span>Name</span><strong>@TempData["Name"]</strong></div>
    <div class="fact"><span>Email</span><strong>@TempData["Email"]</strong></div>
    <div class="fact"><span>Member since</span><strong>@since</strong></div>
    <div class="fact"><span>Account ID</span><code>@TempData["UserID"]</code></div>
</div>
<div class="actions" style="margin-top:22px">
    <a class="btn plain" href="/User/ChangePassword">Change password</a>
</div>
