@model TaskControl.Models.UserChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Narrow"] = true;
    Layout = "~/Views/Shared/Layout.cshtml";
}

<a class="back" href="/User/Information">Back to your account</a>
<h1>Change password</h1>

@using (Html.BeginForm("ChangePassword", "User", FormMethod.Post, new { @autocomplete = "off", @class = "sheet form single" }))
{
    <label class="field">Current password
        @Html.PasswordFor(model => model.ActualPassWord)
        @Html.ValidationMessageFor(model => model.ActualPassWord)
    </label>
    <label class="field">New password
        <span class="rules">8 to 20 characters, with an uppercase letter, a lowercase letter, a number and one of ! @@ # $ % &amp;</span>
        @Html.PasswordFor(model => model.NewPassWord)
        @Html.ValidationMessageFor(model => model.NewPassWord)
    </label>
    <label class="field">Confirm the new password
        @Html.PasswordFor(model => model.NewPassWordConfirm)
        @Html.ValidationMessageFor(model => model.NewPassWordConfirm)
    </label>
    <div class="actions">
        <button type="submit" class="btn pen">Change password</button>
        <a class="btn plain" href="/User/Information">Cancel</a>
    </div>
}
