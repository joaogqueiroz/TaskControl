@{
    Layout = null;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Current(bool on) => on ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} - Task Control" : "Task Control")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/atkinson-hyperlegible-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="top">
        <div class="in">
            <a class="brand" href="/Home/Index">Task Control</a>
            <nav aria-label="Main">
                <a href="/Home/Index" aria-current="@Current(controller == "Home")">Month</a>
                <a href="/Task/Consult" aria-current="@Current(controller == "Task" && (action == "Consult" || action == "Edit"))">Tasks</a>
                <a href="/Task/Registration" aria-current="@Current(controller == "Task" && action == "Registration")">New task</a>
                <a href="/Task/Report" aria-current="@Current(controller == "Task" && action == "Report")">Report</a>
            </nav>
            <a class="me" href="/User/Information" aria-current="@Current(controller == "User")">@User.Identity.Name</a>
            <a class="me" href="/Account/Logout">Log out</a>
        </div>
    </header>

    <main class="@(ViewData["Narrow"] is true ? "narrow" : null)">
        @if (TempData["Message"] != null)
        {
            <div class="notice" role="status">@TempData["Message"]</div>
        }
        @RenderBody()
    </main>

    <script src="~/js/site.js"></script>
</body>
</html>
