@model TaskControl.Models.AccountPasswordRecoveryModel
@{
    Layout = "~/Views/Shared/AuthLayout.cshtml";
    ViewData["Title"] = "Forgot your password";
    ViewData["Sub"] = "We'll email you a link to choose a new one.";
}

@using (Html.BeginForm("Passwordrecovery", "Account", FormMethod.Post, new { @autocomplete = "off" }))
{
    <label class="field">Email
        @Html.TextBoxFor(model => model.Email, new { @type = "email" })
        @Html.ValidationMessageFor(model => model.Email)
    </label>
    <button type="submit" class="btn pen">Send the link</button>
    <div class="links"><a href="/Account/Login">Back to log in</a><span></span></div>
}
