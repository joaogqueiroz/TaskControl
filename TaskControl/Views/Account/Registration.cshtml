@model TaskControl.Models.AccountRegistrationModel
@{
    Layout = "~/Views/Shared/AuthLayout.cshtml";
    ViewData["Title"] = "Create an account";
    ViewData["Sub"] = "Create an account to plan your month.";
}

@using (Html.BeginForm("Registration", "Account", FormMethod.Post, new { @autocomplete = "off" }))
{
    <label class="field">Name
        @Html.TextBoxFor(model => model.Name)
        @Html.ValidationMessageFor(model => model.Name)
    </label>
    <label class="field">Email
        @Html.TextBoxFor(model => model.Email, new { @type = "email" })
        @Html.ValidationMessageFor(model => model.Email)
    </label>
    <div class="two">
        <label class="field">Password
            @Html.PasswordFor(model => model.PassWord, new { @autocomplete = "new-password" })
        </label>
        <label class="field">Confirm
            @Html.PasswordFor(model => model.PassWordConfirm, new { @autocomplete = "new-password" })
        </label>
    </div>
    @Html.ValidationMessageFor(model => model.PassWord)
    @Html.ValidationMessageFor(model => model.PassWordConfirm)
    <p class="rules" style="margin-top:8px">8 to 20 characters, with an uppercase letter, a lowercase letter, a number and one of ! @@ # $ % &amp;</p>
    <button type="submit" class="btn pen">Create account</button>
    <div class="links"><span></span><a href="/Account/Login">I already have an account</a></div>
}
