@model TaskControl.Models.AccountResetPasswordModel
@{
    Layout = "~/Views/Shared/AuthLayout.cshtml";
    ViewData["Title"] = "Choose a new password";
    ViewData["Sub"] = "Choose a new password.";
}

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @autocomplete = "off" }))
{
    @Html.HiddenFor(model => model.Token)
    @Html.ValidationMessageFor(model => model.Token)
    <label class="field">New password
        @Html.PasswordFor(model => model.NewPassWord, new { @autocomplete = "new-password" })
        @Html.ValidationMessageFor(model => model.NewPassWord)
    </label>
    <label class="field">Confirm the new password
        @Html.PasswordFor(model => model.NewPassWordConfirm, new { @autocomplete = "new-password" })
        @Html.ValidationMessageFor(model => model.NewPassWordConfirm)
    </label>
    <p class="rules" style="margin-top:8px">8 to 20 characters, with an uppercase letter, a lowercase letter, a number and one of ! @@ # $ % &amp;</p>
    <button type="submit" class="btn pen">Save the new password</button>
    <div class="links"><a href="/Account/Passwordrecovery">Ask for a new link</a><span></span></div>
}
