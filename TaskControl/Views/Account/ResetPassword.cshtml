@model TaskControl.Models.AccountResetPasswordModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Reset password</title>
    <!--CSS FILES HERE USING LINK TAG-->
    <link href="~/css/bootstrap.css" rel="stylesheet" />
</head>
<body class="bg-dark text-white">
    <div class="mt-5 col-md-4 offset-md-4">
        <div class="card bg-secondary text-white">
            <div class="card-body text-center rounded-0">
                <h5>Choose a new password</h5>
                <hr />

                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-secondary alert-dismissible fade show" role="alert">
                        <strong>@TempData["Message"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @autocomplete = "off" }))
                {
                    @Html.HiddenFor(model => model.Token)
                    <span class="text-danger">
                        @Html.ValidationMessageFor(model => model.Token)
                    </span>

                    <label>New password</label>
                    @Html.PasswordFor(model => model.NewPassWord, new { @class = "form-control" })
                    <span class="text-danger">
                        @Html.ValidationMessageFor(model => model.NewPassWord)
                    </span>
                    <br />

                    <label>Confirm the new password</label>
                    @Html.PasswordFor(model => model.NewPassWordConfirm, new { @class = "form-control" })
                    <span class="text-danger">
                        @Html.ValidationMessageFor(model => model.NewPassWordConfirm)
                    </span>
                    <br />

                    <div class="d-grid">
                        <input type="submit" class="btn btn-dark" value="Save the new password" />
                        <br />
                        <a href="/Account/Passwordrecovery" class="btn btn-light">Ask for a new link</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!--JS FILES HERE USING SCRIPT TAG-->
    <script src="~/js/bootstrap.bundle.js"></script>
</body>
</html>
