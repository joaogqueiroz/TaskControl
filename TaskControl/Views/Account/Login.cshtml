@model TaskControl.Models.AccountLoginModel
@{
    Layout = "~/Views/Shared/AuthLayout.cshtml";
    ViewData["Title"] = "Log in";
    ViewData["Sub"] = "Log in to plan your month.";
    ViewData["NoticeKind"] = "error";
}

@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @autocomplete = "off" }))
{
    <label class="field">Email
        @Html.TextBoxFor(model => model.Email, new { @type = "email", @autocomplete = "username" })
        @Html.ValidationMessageFor(model => model.Email)
    </label>
    <label class="field">Password
        @Html.PasswordFor(model => model.PassWord, new { @autocomplete = "current-password" })
        @Html.ValidationMessageFor(model => model.PassWord)
    </label>
    <button type="submit" class="btn pen">Log in</button>
    <div class="links">
        <a href="/Account/PasswordRecovery">Forgot your password?</a>
        <a href="/Account/Registration">Create an account</a>
    </div>
}
