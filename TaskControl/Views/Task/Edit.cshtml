@model TaskControl.Models.TaskEditModel
@{
    ViewData["Title"] = "Edit task";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<a class="back" href="/Task/Consult">Back to tasks</a>
<h1>Edit task</h1>

@using (Html.BeginForm("Edit", "Task", FormMethod.Post, new { @autocomplete = "off", @class = "sheet form" }))
{
    @Html.HiddenFor(model => model.TaskID)
    <label class="field wide">Task
        @Html.TextBoxFor(model => model.Name)
        @Html.ValidationMessageFor(model => model.Name)
    </label>
    <label class="field">Date
        @Html.TextBoxFor(model => model.Date, new { @type = "date" })
        @Html.ValidationMessageFor(model => model.Date)
    </label>
    <label class="field">Time
        @Html.TextBoxFor(model => model.Hour, new { @type = "time" })
        @Html.ValidationMessageFor(model => model.Hour)
    </label>
    @await Html.PartialAsync("_PriorityPicker", (Model?.Priority ?? TaskControl.Models.TaskPriority.MEDIUM).ToString())
    <label class="field wide">Description
        @Html.TextAreaFor(model => model.Description)
        @Html.ValidationMessageFor(model => model.Description)
    </label>
    <div class="actions">
        <button type="submit" class="btn pen">Save changes</button>
        <a class="btn plain" href="/Task/Consult">Cancel</a>
    </div>
}
