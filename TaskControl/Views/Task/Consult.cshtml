@using System.Globalization
@using TaskControl.Data.Entities
@{
    ViewData["Title"] = "Tasks";
    Layout = "~/Views/Shared/Layout.cshtml";
    var us = CultureInfo.GetCultureInfo("en-US");
    var tasks = (TempData["Tasks"] as List<TaskControl.Data.Entities.Task> ?? new List<TaskControl.Data.Entities.Task>())
        .OrderBy(t => t.Date).ThenBy(t => t.Hour).ToList();
}

<div class="bar-top">
    <div>
        <h1>Tasks</h1>
        <p class="sub">Everything you have planned, by date.</p>
    </div>
    @if (tasks.Count > 0)
    {
        <input class="search" type="search" placeholder="Search tasks" aria-label="Search tasks" data-search="#rows" />
    }
</div>

@if (tasks.Count == 0)
{
    <div class="sheet empty" style="margin-top:22px">
        <h2>No tasks yet</h2>
        <p>Add your first task and it is listed here.</p>
        <a class="btn pen" href="/Task/Registration">Add a task</a>
    </div>
}
else
{
    <div class="sheet table-wrap">
        <table>
            <thead>
                <tr><th>Date</th><th>Task</th><th>Priority</th><th>Description</th><th><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody id="rows">
                @foreach (var task in tasks)
                {
                    <tr>
                        <td class="when">@task.Date.ToString("ddd, MMM d", us), @task.Hour.ToString(@"hh\:mm")</td>
                        <td><strong>@task.Name</strong></td>
                        <td>@await Html.PartialAsync("_Priority", task.Priority)</td>
                        <td class="desc">@task.Description</td>
                        <td class="act">
                            <a href="@Url.Action("Edit", "Task", new { id = task.TaskID })">Edit</a>
                            <form method="post" action="/Task/Delete" onsubmit="return confirm('Delete this task?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@task.TaskID" />
                                <button type="submit" class="linklike del">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="count"><span data-count>@tasks.Count</span> @(tasks.Count == 1 ? "task" : "tasks")</div>
    </div>
}
