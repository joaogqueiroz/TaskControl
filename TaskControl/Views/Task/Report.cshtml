@model TaskControl.Models.TaskReportModel
@{
    ViewData["Title"] = "Report";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<h1>Report</h1>
<p class="sub">Download the tasks of a period as a PDF.</p>

@using (Html.BeginForm("Report", "Task", FormMethod.Post, new { @autocomplete = "off", @class = "sheet form" }))
{
    <label class="field">From
        @Html.TextBoxFor(model => model.StartDate, new { @type = "date" })
        @Html.ValidationMessageFor(model => model.StartDate)
    </label>
    <label class="field">To
        @Html.TextBoxFor(model => model.FinishDate, new { @type = "date" })
        @Html.ValidationMessageFor(model => model.FinishDate)
    </label>
    <p class="notice wide" style="grid-column:1/-1;margin-top:0">The PDF lists each task in the period with its date, time, priority and description.</p>
    <div class="actions">
        <button type="submit" class="btn pen">Download PDF</button>
    </div>
}
